# --- required in production ---
PAYSTACK_MODE=live                 # "mock" for local tests
PAYSTACK_SECRET_KEY=sk_test_xxx    # TEST key only. Never a live key for this exercise.
MCP_BEARER_TOKEN=change-me-long-random   # Chord sends this as the bearer token
OPS_TOKEN=change-me-too                  # protects /ops/inbox and /ops/reseed
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- how the owner receives approval codes (ops inbox is always on) ---
RESEND_API_KEY=
OWNER_EMAIL=
OWNER_WEBHOOK_URL=

# --- optional tuning ---
BRAND_NAME=Railow
AUTO_CREDIT_LIMIT_KOBO=10000000    # ₦100,000
