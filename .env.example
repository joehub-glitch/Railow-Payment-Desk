# --- required in production ---
PAYSTACK_MODE=live                 # "mock" for local tests
PAYSTACK_SECRET_KEY=sk_test_xxx    # TEST key only. Never a live key for this exercise.
MCP_BEARER_TOKEN=change-me-long-random   # Chord sends this as the bearer token
OPS_TOKEN=change-me-too                  # protects /ops/diagnose, /ops/seed-links, /ops/reseed
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Ops Console approvers (letters and numbers only; each person keeps their own) ---
APPROVER_OPS_LEAD_PASSWORD=
APPROVER_FINANCE_PASSWORD=

# --- optional: where "claim needs review" alerts go (no codes or links are sent) ---
RESEND_API_KEY=
OWNER_EMAIL=
OWNER_WEBHOOK_URL=

# --- optional tuning ---
BRAND_NAME=Railow
AUTO_CREDIT_LIMIT_KOBO=10000000    # ₦100,000
FOUR_EYES_KOBO=5000000             # ₦50,000 and above needs two approvers
AGENT_REFUND_HARD_CAP_KOBO=10000000 # ceiling on the agent refund limit set in Chord (₦100,000)
